    "faq_semen": {
      "type": "faq-accordion",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "faq_title": "Kako poteka dostava in koliko stane?",
            "faq_des": "<p>Pošiljamo po vsej Sloveniji. Naročilo odpošljemo v 1–3 delovnih dneh, strošek dostave se izračuna v košarici. Po dogovoru je možen tudi osebni prevzem v čebelnjaku na Melincih.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "faq_title": "Med se mi je strdil. Je še dober?",
            "faq_des": "<p>Da. Kristalizacija je naraven proces in znak pristnega, nepregretega medu. Kozarec postavite v toplo vodno kopel do 40 °C in med se znova utekočini, brez izgube kakovosti.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "faq_title": "Kateri med naj izberem?",
            "faq_des": "<p>Za čaj in kavo akacijev ali lipov med, za namaze sončnični ali cvetlični, k siru in mesu kostanjev, za zimske mesece gozdni, hojev ali ajdov med. Ob obisku čebelnjaka lahko vse vrste tudi poskusite.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "faq_title": "Kako se naročim na obisk čebelnjaka?",
            "faq_des": "<p>Obiski potekajo po predhodnem dogovoru. Pišite nam prek kontaktnega obrazca ali pokličite, sporočite želeni termin in število oseb. Sprejemamo posameznike, družine in skupine.</p>"
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "faq_title": "Ali pripravljate darilne pakete?",
            "faq_des": "<p>Da. Sestavite lahko svojo kombinacijo medov in čebeljih izdelkov, mi pa jo lepo zapakiramo. Za večje količine ali poslovna darila nas kontaktirajte.</p>"
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "faq_title": "Kje se nahajate?",
            "faq_des": "<p>Na Melincih, 12 km od Murske Sobote, le 500 m od reke Mure. V bližini so brod v Gornji Bistrici ter terme Banovci, Moravske Toplice in Lendava.</p>"
          }
        }
      },
      "block_order": [
        "q1",
