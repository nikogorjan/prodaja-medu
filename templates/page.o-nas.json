          "type": "month",
          "settings": {
            "name": "Februar",
            "short": "feb",
            "season": "Zima",
            "color": "#9fb3bd",
            "bees": "Matica začne zalegati, v sredini gruče se segreje. Družina se počasi prebuja.",
            "work": "Od zunaj preverjamo, ali imajo družine dovolj hrane, in čakamo na prve tople dni."
          }
