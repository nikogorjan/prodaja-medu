          "settings": {
            "name": "Oktober",
            "short": "okt",
            "season": "Jesen",
            "color": "#c0703f",
            "bees": "Zalega se zmanjšuje, družina se krči in umirja.",
            "work": "Zadnji pregledi. Zožimo žrela panjev, da je v njih topleje in varneje."
