            "short": "sep",
            "season": "Jesen",
            "color": "#c0703f",
            "bees": "Vzgajajo zimske čebele, ki živijo več mesecev, ne le nekaj tednov.",
            "work": "Točimo ajdov med in poskrbimo, da imajo družine dovolj hrane za zimo."
          }
        },
        "m10": {
