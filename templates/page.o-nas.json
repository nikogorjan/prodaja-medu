        "m03": {
          "type": "month",
          "settings": {
            "name": "Marec",
            "short": "mar",
            "season": "Pomlad",
            "color": "#9bb068",
            "bees": "Ob prvih toplih dneh opravijo pročiščevalni izlet in nosijo prvi cvetni prah z leske in vrbe.",
            "work": "Prvi pregled družin na toplem, mirnem dnevu: kako so prezimile in kakšna je matica."
          }
        },
        "m04": {
          "type": "month",
          "settings": {
            "name": "April",
            "short": "apr",
            "season": "Pomlad",
            "color": "#9bb068",
            "bees": "Na sadnem drevju, regratu in oljni ogrščici družine hitro rastejo, vsak dan se izleže na stotine mladih čebel.",
            "work": "Širimo gnezda, dodajamo satnice in pripravljamo panje za prvo pašo."
          }
        },
        "m05": {
          "type": "month",
          "settings": {
            "name": "Maj",
            "short": "maj",
            "season": "Pomlad",
            "color": "#9bb068",
            "bees": "Vrhunec razvoja. Družine so močne, v zraku je rojilni nagon.",
            "work": "Pazimo, da se ne rojijo, in čebele odpeljemo na akacijo."
          }
        },
        "m06": {
          "type": "month",
          "settings": {
            "name": "Junij",
            "short": "jun",
            "season": "Poletje",
            "color": "#e0a83a",
            "bees": "Nabirajo nektar na lipi in kostanju, v gozdovih mano.",
            "work": "Točimo akacijev med in panje selimo na nove paše."
          }
        },
        "m07": {
          "type": "month",
          "settings": {
            "name": "Julij",
            "short": "jul",
            "season": "Poletje",
            "color": "#e0a83a",
            "bees": "Najmočnejše družine leta, panj šteje več deset tisoč čebel.",
            "work": "Točimo lipov in kostanjev med, čebele vozimo na sončnice."
          }
        },
        "m08": {
          "type": "month",
          "settings": {
            "name": "Avgust",
            "short": "avg",
            "season": "Poletje",
            "color": "#e0a83a",
            "bees": "Paše se končujejo, ajda še cveti. Družine začnejo zmanjševati zalego.",
            "work": "Zadnja točenja, skrb za zdravje čebel in začetek priprave na zimo."
          }
        },
        "m09": {
