{%- comment -%}
  Povezave na strani bloga, ko strani niso enako dolge (sections/blog-template-1.liquid, "Najnovejša objava
  velika": 1. stran ima veliko objavo in polno mrežo, ostale samo mrežo). Videz in razredi so enaki kot v
  snippets/pagination.liquid. Povezava ohrani filter oznake (request.path, npr. /blogs/news/tagged/nasveti).
  Uporaba: {% render 'semen-pagination', current: 2, pages: 3 %}
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-pagination.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-pagination.css' | asset_url | stylesheet_tag }}</noscript>
{%- assign base = request.path -%}
<div class="pagination-wrapper pagination-blog">
  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list list-unstyled" role="list">
      {%- if current > 1 -%}
        {%- assign prev = current | minus: 1 -%}
        <li>
          <a href="{{ base }}{% if prev > 1 %}?page={{ prev }}{% endif %}" class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce" aria-label="{{ 'general.pagination.previous' | t }}">
            {% render 'icon-caret' %}
          </a>
        </li>
      {%- endif -%}
      {%- for n in (1..pages) -%}
        <li>
          {%- if n == current -%}
            <span class="pagination__item pagination__item--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: n }}">{{ n }}</span>
          {%- else -%}
            <a href="{{ base }}{% if n > 1 %}?page={{ n }}{% endif %}" class="pagination__item link" aria-label="{{ 'general.pagination.page' | t: number: n }}">{{ n }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if current < pages -%}
        <li>
          <a href="{{ base }}?page={{ current | plus: 1 }}" class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce" aria-label="{{ 'general.pagination.next' | t }}">
            {%- render 'icon-caret' -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
</div>
