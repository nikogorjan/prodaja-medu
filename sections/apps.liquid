<div class="customstyle{{ section.id }} " data-aos="{{ section.settings.animation }}" >
    {%- render 'style-section' -%}
    <div class="{{ section.settings.setwidth }}">
    {%- for block in section.blocks -%}
        {% render block %}
    {%- endfor -%}
    </div>
</div>

{% schema %}
{
  "name": "Aplikacije",
  "tag": "section",
  "class": "index-section",
  "settings": [
    {
      "type": "select",
      "id": "animation",
      "options": [
        {
          "value": "",
          "label": "Brez"
        },
        {
          "value": "fade",
          "label": "Pojav"
        },
        {
          "value": "fade-up",
          "label": "Pojav navzgor"
        },
        {
          "value": "fade-down",
          "label": "Pojav navzdol"
        },
        {
          "value": "fade-left",
          "label": "Pojav v levo"
        },
        {
          "value": "fade-right",
          "label": "Pojav v desno"
        },
        {
          "value": "fade-up-right",
          "label": "Pojav navzgor desno"
        },
        {
          "value": "fade-up-left",
          "label": "Pojav navzgor levo"
        },
        {
          "value": "fade-down-right",
          "label": "Pojav navzdol desno"
        },
        {
          "value": "fade-down-left",
          "label": "Pojav navzdol levo"
        },
        {
          "value": "flip-up",
          "label": "Obrat navzgor"
        },
        {
          "value": "flip-down",
          "label": "Obrat navzdol"
        },
        {
          "value": "flip-left",
          "label": "Obrat v levo"
        },
        {
          "value": "flip-right",
          "label": "Obrat v desno"
        },
        {
          "value": "slide-up",
          "label": "Zdrs navzgor"
        },
        {
          "value": "slide-down",
          "label": "Zdrs navzdol"
        },
        {
          "value": "slide-left",
          "label": "Zdrs v levo"
        },
        {
          "value": "slide-right",
          "label": "Zdrs v desno"
        },
        {
          "value": "zoom-in",
          "label": "Povečava"
        },
        {
          "value": "zoom-in-up",
          "label": "Povečava navzgor"
        },
        {
          "value": "zoom-in-down",
          "label": "Povečava navzdol"
        },
        {
          "value": "zoom-in-left",
          "label": "Povečava v levo"
        },
        {
          "value": "zoom-in-right",
          "label": "Povečava v desno"
        },
        {
          "value": "zoom-out",
          "label": "Pomanjšava"
        },
        {
          "value": "zoom-out-up",
          "label": "Pomanjšava navzgor"
        },
        {
          "value": "zoom-out-down",
          "label": "Pomanjšava navzdol"
        },
        {
          "value": "zoom-out-left",
          "label": "Pomanjšava v levo"
        },
        {
          "value": "zoom-out-right",
          "label": "Pomanjšava v desno"
        }
      ],
      "label": "Animacija ob prikazu"
    },
    {
      "type": "select",
      "id": "setwidth",
      "label": "Čez celo širino",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Okvir"
        },
        {
          "value": "container-fluid",
          "label": "Čez celo širino"
        },
        {
          "value": "full",
          "label": "Polna širina"
        }
      ]
    },
    {
      "type": "text",
      "id": "paddingsection",
      "label": "Notranji odmik sekcije",
      "default": "0px 0px 0px 0px",
      "info": "Notranji odmik: zgoraj desno spodaj levo"
    },
    {
      "type": "text",
      "id": "paddingmobile",
      "label": "Notranji odmik sekcije na telefonu",
      "default": "60px 0px 60px 0px",
      "info": "Notranji odmik: zgoraj desno spodaj levo"
    },
    {
      "type": "text",
      "id": "marginsection",
      "label": "Zunanji odmik sekcije",
      "default": "0px 0px 0px 0px",
      "info": "Zunanji odmik: zgoraj desno spodaj levo"
    },
    {
      "type": "text",
      "id": "marginmobile",
      "label": "Zunanji odmik na telefonu",
      "default": "0px 0px 0px 0px",
      "info": "Zunanji odmik: zgoraj desno spodaj levo"
    },
    {
      "type": "color",
      "id": "bgsection",
      "label": "Ozadje sekcije",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Aplikacije"
    }
  ]
}
{% endschema %}
