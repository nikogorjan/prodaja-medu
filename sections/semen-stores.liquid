{%- comment -%}
  Najdete nas v trgovinah (Čebelarstvo Šemen): trgovine, kjer so naprodaj naši izdelki.
  Vsaka trgovina je blok: ime, logotip, naslov, delovni čas, telefon, opomba, gumb "Navodila za pot" (Google Zemljevidi)
  in na vrhu kartice po izbiri fotografija lokacije ali zemljevid. Zemljevid se naloži šele, ko ga obiskovalec odpre
  s klikom, zato Google pred tem ne nastavi piškotkov. Navodila za pot in zemljevid nastanejo iz naslova.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign stores = section.blocks | where: 'type', 'store'
  case s.scheme
    when 'cream'
      assign bg = 'var(--s-plate, #f7f3ea)'
    when 'tint'
      assign bg = 'var(--s-tint, #f6edd3)'
    else
      assign bg = 'var(--s-bg, #ffffff)'
  endcase
  assign cols = s.columns | plus: 0
-%}
<style>
  .sst-{{ sid }} { --sst-accent: {{ s.accent }}; background: {{ bg }}; padding: {{ s.padding_top | times: 0.55 | round }}px 0 {{ s.padding_bottom | times: 0.55 | round }}px; scroll-margin-top: 90px; }
  .sst-{{ sid }} .sst-head { max-width: 720px; margin: 0 auto 36px; text-align: center; }
  .sst-{{ sid }} .sst-title { margin: 6px 0 0; text-wrap: balance; }
  .sst-{{ sid }} .sst-intro { margin: 14px auto 0; max-width: 58ch; color: var(--s-muted, #5c6978); }
  .sst-{{ sid }} .sst-intro p { margin: 0; }
  /* nepopolna zadnja vrsta je na sredini */
  .sst-{{ sid }} .sst-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .sst-{{ sid }} .sst-card { flex: 1 1 100%; display: flex; flex-direction: column; margin: 0; background: var(--s-card, #ffffff); border: 1px solid var(--s-rule-solid, #ece4d4); }
  .sst-{{ sid }} .sst-media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--s-plate, #f3ebda); border-bottom: 1px solid var(--s-rule-solid, #ece4d4); }
  .sst-{{ sid }} .sst-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sst-{{ sid }} .sst-media iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .sst-{{ sid }} .sst-map { background-image: linear-gradient(var(--s-rule, rgba(34,34,34,.08)) 1px, transparent 1px), linear-gradient(90deg, var(--s-rule, rgba(34,34,34,.08)) 1px, transparent 1px); background-size: 32px 32px; background-position: center; }
  .sst-{{ sid }} .sst-map-btn { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 20px; border: 0; background: transparent; color: var(--s-ink, #222222); font: inherit; cursor: pointer; transition: background-color .3s; }
  .sst-{{ sid }} .sst-map-btn:hover { background: rgba(255, 255, 255, .35); }
  .sst-{{ sid }} .sst-map-btn .semen-icon { color: var(--sst-accent); }
  .sst-{{ sid }} .sst-map-label { font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; border-bottom: 1px solid var(--sst-accent); padding-bottom: 3px; }
  .sst-{{ sid }} .sst-map-note { font-size: 12px; color: var(--s-muted, #5c6978); }
  .sst-{{ sid }} .sst-body { display: flex; flex: 1 1 auto; flex-direction: column; gap: 16px; padding: 24px 22px 26px; }
  .sst-{{ sid }} .sst-logo { display: block; width: auto; height: {{ s.logo_height }}px; max-width: 75%; object-fit: contain; object-position: left center; }
  .sst-{{ sid }} .sst-name { margin: 0; font-size: 20px; line-height: 1.3; }
  .sst-{{ sid }} .sst-list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .sst-{{ sid }} .sst-row { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 12px; margin: 0; font-size: 14px; line-height: 1.6; color: var(--s-text, #4a4540); }
  .sst-{{ sid }} .sst-row .semen-icon { margin-top: 2px; color: var(--sst-accent); }
  .sst-{{ sid }} .sst-row a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--sst-accent); }
  .sst-{{ sid }} .sst-actions { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: auto; padding-top: 6px; }
  .sst-{{ sid }} .sst-empty { padding: 28px; border: 1px dashed var(--s-rule-strong, rgba(34,34,34,.2)); text-align: center; color: var(--s-muted, #5c6978); }
  @media (min-width: 750px) {
    .sst-{{ sid }} { padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
    .sst-{{ sid }} .sst-head { margin-bottom: 52px; }
    .sst-{{ sid }} .sst-grid { gap: 24px; }
    {%- if cols > 1 %}
    .sst-{{ sid }} .sst-card { flex: 0 1 calc((100% - 24px) / 2); }
    {%- endif %}
  }
  @media (min-width: 990px) {
    .sst-{{ sid }} .sst-grid { gap: 28px; }
    .sst-{{ sid }} .sst-card { flex: 0 1 calc((100% - {{ cols | minus: 1 | times: 28 }}px) / {{ cols }}); }
  }
</style>

<section class="sst-{{ sid }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="{{ s.setwidth }}">
    {%- if s.title_top != blank or s.title != blank or s.des != blank -%}
      <div class="sst-head" data-aos="fade-up">
        {%- if s.title_top != blank -%}<span class="subtop">{{ s.title_top | escape }}</span>{%- endif -%}
        {%- if s.title != blank -%}<h2 class="h2 sst-title">{% render 'semen-em', text: s.title %}</h2>{%- endif -%}
        {%- if s.des != blank -%}<div class="sst-intro">{{ s.des }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if stores.size > 0 -%}
      <ul class="sst-grid" role="list">
        {%- for block in stores -%}
          {%- liquid
            assign b = block.settings
            assign place = b.map_query | default: b.address | newline_to_br | replace: '<br />', ', ' | strip_newlines | strip
            assign place_q = place | url_encode
            assign directions = b.directions_url
            if directions == blank and place != blank
              assign directions = 'https://www.google.com/maps/dir/?api=1&destination=' | append: place_q
            endif
            assign photo_alt = b.photo.alt | default: b.name
          -%}
          <li class="sst-card" {{ block.shopify_attributes }} data-aos="fade-up" data-aos-delay="{{ forloop.index0 | modulo: cols | times: 100 }}">
            {%- if b.media == 'photo' and b.photo != blank -%}
              <div class="sst-media">
                {{ b.photo | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: photo_alt }}
              </div>
            {%- elsif b.media == 'map' and place != blank -%}
              <div class="sst-media sst-map" data-src="https://www.google.com/maps?q={{ place_q }}&amp;z=15&amp;output=embed">
                <button type="button" class="sst-map-btn" data-title="{{ s.label_map | escape }}: {{ b.name | escape }}">
                  {%- render 'semen-icon', icon: 'pin', size: 30 -%}
                  <span class="sst-map-label">{{ s.label_map | escape }}</span>
                  {%- if s.label_map_note != blank -%}<span class="sst-map-note">{{ s.label_map_note | escape }}</span>{%- endif -%}
                </button>
              </div>
            {%- endif -%}
            <div class="sst-body">
              {%- if b.logo != blank -%}
                {{ b.logo | image_url: height: 160 | image_tag: class: 'sst-logo', loading: 'lazy', alt: b.logo.alt | default: b.name }}
              {%- endif -%}
              {%- if b.name != blank -%}<h3 class="sst-name">{{ b.name | escape }}</h3>{%- endif -%}
              <ul class="sst-list" role="list">
                {%- if b.address != blank -%}
                  <li class="sst-row">{%- render 'semen-icon', icon: 'pin', size: 20 -%}<span>{{ b.address | escape | newline_to_br }}</span></li>
                {%- endif -%}
                {%- if b.hours != blank -%}
                  <li class="sst-row">{%- render 'semen-icon', icon: 'clock', size: 20 -%}<span>{{ b.hours | escape | newline_to_br }}</span></li>
                {%- endif -%}
                {%- if b.phone != blank -%}
                  <li class="sst-row">{%- render 'semen-icon', icon: 'phone', size: 20 -%}<span><a href="tel:{{ b.phone | remove: ' ' }}">{{ b.phone | escape }}</a></span></li>
                {%- endif -%}
                {%- if b.note != blank -%}
                  <li class="sst-row">{%- render 'semen-icon', icon: 'jar', size: 20 -%}<span>{{ b.note | escape }}</span></li>
                {%- endif -%}
              </ul>
              {%- if directions != blank or b.website != blank -%}
                <div class="sst-actions">
                  {%- if directions != blank -%}<a class="btn btn-underline" href="{{ directions }}" target="_blank" rel="noopener">{{ s.label_directions | escape }}</a>{%- endif -%}
                  {%- if b.website != blank -%}<a class="btn btn-underline" href="{{ b.website }}" target="_blank" rel="noopener">{{ s.label_website | escape }}</a>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="sst-empty">Dodajte trgovino: v levem stolpcu kliknite »Dodaj blok« in izberite »Trgovina«.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('.sst-{{ sid }}');
    if (!root || root.dataset.sstReady) return;
    root.dataset.sstReady = '1';
    // zemljevid se naloži šele ob kliku (prej Google ne nastavi piškotkov)
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.sst-map-btn');
      if (!btn) return;
      var box = btn.parentElement;
      var frame = document.createElement('iframe');
      frame.src = box.getAttribute('data-src');
      frame.title = btn.getAttribute('data-title') || '';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
    });
  })();
</script>

{% schema %}
{
  "name": "Najdete nas v trgovinah",
  "tag": "section",
  "class": "section-semen-stores",
  "settings": [
    { "type": "paragraph", "content": "Trgovine, kjer so naprodaj vaši izdelki. Vsaka trgovina je svoj blok (Dodaj blok › Trgovina). Navodila za pot in zemljevid nastanejo iz naslova trgovine." },
    { "type": "select", "id": "scheme", "label": "Ozadje sekcije", "default": "cream", "options": [ { "value": "white", "label": "Slonokoščeno (osnovno)" }, { "value": "cream", "label": "Pšenično (toplo)" }, { "value": "tint", "label": "Medeno (svetel pas)" } ] },
    { "type": "color", "id": "accent", "label": "Barva ikon in črt", "default": "#c99a5c" },
    { "type": "select", "id": "setwidth", "label": "Širina", "default": "container", "options": [ { "value": "container", "label": "Širina vsebine" }, { "value": "container-fluid", "label": "Čez celo širino" } ] },
    { "type": "text", "id": "anchor", "label": "Sidro (neobvezno)", "info": "Npr. trgovine – povezava #trgovine potem skoči na to sekcijo." },
    { "type": "header", "content": "Glava" },
    { "type": "text", "id": "title_top", "label": "Nadnaslov", "default": "Kje kupiti" },
    { "type": "text", "id": "title", "label": "Naslov", "default": "Najdete nas v trgovinah" },
    { "type": "richtext", "id": "des", "label": "Uvod", "default": "<p>Naš med in čebelje izdelke lahko kupite tudi v teh trgovinah.</p>" },
    { "type": "header", "content": "Kartice trgovin" },
    { "type": "select", "id": "columns", "label": "Kartic v vrsti na računalniku", "default": "3", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "range", "id": "logo_height", "label": "Višina logotipa", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "text", "id": "label_directions", "label": "Besedilo gumba za pot", "default": "Navodila za pot" },
    { "type": "text", "id": "label_website", "label": "Besedilo gumba za spletno stran", "default": "Spletna stran" },
    { "type": "text", "id": "label_map", "label": "Besedilo gumba za zemljevid", "default": "Prikaži zemljevid" },
    { "type": "text", "id": "label_map_note", "label": "Opomba pod gumbom za zemljevid", "default": "Zemljevid prikaže Google Zemljevidi." },
    { "type": "header", "content": "Odmiki" },
    { "type": "range", "id": "padding_top", "label": "Odmik zgoraj", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Odmik spodaj", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Trgovina",
      "settings": [
        { "type": "text", "id": "name", "label": "Ime trgovine", "default": "Ime trgovine" },
        { "type": "image_picker", "id": "logo", "label": "Logotip trgovine", "info": "Najbolje PNG s prozornim ozadjem." },
        { "type": "textarea", "id": "address", "label": "Naslov", "info": "Ulica in hišna številka, v drugi vrstici poštna številka in kraj. Iz naslova nastaneta navodila za pot in zemljevid." },
        { "type": "textarea", "id": "hours", "label": "Delovni čas", "info": "Vsak dan v svojo vrstico, npr. pon–pet: 8–19." },
        { "type": "text", "id": "phone", "label": "Telefon" },
        { "type": "text", "id": "note", "label": "Opomba", "info": "Npr. Naš med najdete na polici z lokalnimi izdelki." },
        { "type": "header", "content": "Slika na vrhu kartice" },
        { "type": "select", "id": "media", "label": "Na vrhu kartice", "default": "photo", "options": [ { "value": "photo", "label": "Fotografija lokacije" }, { "value": "map", "label": "Zemljevid (naloži se ob kliku)" }, { "value": "none", "label": "Nič" } ] },
        { "type": "image_picker", "id": "photo", "label": "Fotografija lokacije" },
        { "type": "header", "content": "Povezave (neobvezno)" },
        { "type": "text", "id": "map_query", "label": "Lokacija za zemljevid in pot", "info": "Le če naslov na zemljevidu ne najde prave točke: vpišite npr. ime trgovine in kraj." },
        { "type": "url", "id": "directions_url", "label": "Lastna povezava za pot", "info": "Pustite prazno: povezava na Google Zemljevide nastane iz naslova." },
        { "type": "url", "id": "website", "label": "Spletna stran trgovine" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Najdete nas v trgovinah",
      "blocks": [ { "type": "store" }, { "type": "store" }, { "type": "store" } ]
    }
  ]
}
{% endschema %}
