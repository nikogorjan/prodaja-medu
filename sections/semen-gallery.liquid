{%- comment -%}
  Galerija (Čebelarstvo Šemen): mozaik fotografij z napisi. Vsaka fotografija ima velikost
  (navadna, široka, visoka, velika 2 × 2); mreža praznine zapolni sama. Na telefonu dva stolpca.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign photos = section.blocks | where: 'type', 'photo'
  if s.scheme == 'dark'
    assign bg = '#2b2420'
  elsif s.scheme == 'cream'
    assign bg = '#f7f3ea'
  else
    assign bg = '#ffffff'
  endif
-%}
<style>
  .sg-{{ sid }} { --sg-accent: {{ s.accent }}; background: {{ bg }}; padding: {{ s.padding_top | times: 0.55 | round }}px 0 {{ s.padding_bottom | times: 0.55 | round }}px; }
  .sg-{{ sid }} .sg-head { text-align: center; margin-bottom: 36px; }
  .sg-{{ sid }} .sg-eyebrow { display: block; margin-bottom: 8px; }
  .sg-{{ sid }} .sg-title { margin: 0; text-wrap: balance; }
  .sg-{{ sid }} .sg-intro { margin: 12px auto 0; max-width: 56ch; color: #5c6978; }
  .sg-{{ sid }} .sg-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 44vw; grid-auto-flow: dense; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .sg-{{ sid }} .sg-item { position: relative; overflow: hidden; margin: 0; background: #e9e1d2; }
  .sg-{{ sid }} .sg-item--wide, .sg-{{ sid }} .sg-item--big { grid-column: span 2; }
  .sg-{{ sid }} .sg-item--tall, .sg-{{ sid }} .sg-item--big { grid-row: span 2; }
  .sg-{{ sid }} .sg-item img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(var(--sg-zoom, 1)); transition: transform .9s cubic-bezier(.2,.6,.2,1); }
  .sg-{{ sid }} .sg-item:hover img { transform: scale(calc(var(--sg-zoom, 1) + .05)); }
  .sg-{{ sid }} .sg-item::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(32,27,23,.6) 0%, rgba(32,27,23,0) 45%); opacity: .85; transition: opacity .4s; pointer-events: none; }
  .sg-{{ sid }} .sg-cap { position: absolute; left: 14px; right: 14px; bottom: 12px; z-index: 2; color: #ffffff; font-size: 12px; line-height: 1.4; letter-spacing: .04em; }
  .sg-{{ sid }} .sg-cap strong { display: block; font-size: 10px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--sg-accent); margin-bottom: 2px; }
  .sg-{{ sid }} .sg-foot { margin-top: 40px; text-align: center; }
  {%- if s.scheme == 'dark' -%}
  .sg-{{ sid }} .sg-title { color: #ffffff; }
  .sg-{{ sid }} .sg-eyebrow { color: var(--sg-accent) !important; }
  .sg-{{ sid }} .sg-intro { color: #cfc4b4; }
  {%- endif -%}
  @media (min-width: 750px) {
    .sg-{{ sid }} .sg-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: {{ s.row_height }}px; gap: 14px; }
    .sg-{{ sid }} .sg-cap { left: 20px; right: 20px; bottom: 18px; font-size: 13px; }
  }
  @media (min-width: 990px) {
    .sg-{{ sid }} { padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
    .sg-{{ sid }} .sg-head { margin-bottom: 52px; }
  }
</style>

<section class="sg-{{ sid }}">
  <div class="{{ s.setwidth }}">
    {%- if s.title_top != blank or s.title != blank or s.des != blank -%}
      <div class="sg-head" data-aos="fade-up">
        {%- if s.title_top != blank -%}<span class="subtop sg-eyebrow">{{ s.title_top | escape }}</span>{%- endif -%}
        {%- if s.title != blank -%}<h2 class="h3 section-title-1 sg-title"><span>{{ s.title | escape }}</span></h2>{%- endif -%}
        {%- if s.des != blank -%}<p class="sg-intro">{{ s.des | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <ul class="sg-grid" role="list">
      {%- for block in photos -%}
        {%- liquid
          assign b = block.settings
          case b.size
            when 'big'
              assign img_sizes = '(min-width: 750px) 50vw, 100vw'
            when 'wide'
              assign img_sizes = '(min-width: 750px) 50vw, 100vw'
            else
              assign img_sizes = '(min-width: 750px) 25vw, 50vw'
          endcase
          assign img_alt = b.image.alt | default: b.title | default: b.caption
          assign img_style = 'object-position: ' | append: b.position
        -%}
        <li class="sg-item sg-item--{{ b.size }}"{% if b.image.src contains '.png' %} style="--sg-zoom: 1.04"{% endif %} {{ block.shopify_attributes }} data-aos="fade-up" data-aos-delay="{{ forloop.index0 | modulo: 4 | times: 80 }}">
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '300, 500, 700, 1000, 1400', sizes: img_sizes, alt: img_alt, style: img_style }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if b.title != blank or b.caption != blank -%}
            <p class="sg-cap">{%- if b.title != blank -%}<strong>{{ b.title | escape }}</strong>{%- endif -%}{{ b.caption | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.button != blank -%}
      <div class="sg-foot"><a class="btn {{ s.style_btn }}" href="{{ s.link | default: '#' }}">{{ s.button | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Galerija (Šemen)",
  "tag": "section",
  "class": "section-semen-gallery",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Barvna shema", "default": "white", "options": [ { "value": "white", "label": "Bela" }, { "value": "cream", "label": "Kremna" }, { "value": "dark", "label": "Temna" } ] },
    { "type": "color", "id": "accent", "label": "Poudarna barva", "default": "#c99a5c" },
    { "type": "select", "id": "setwidth", "label": "Širina", "default": "container", "options": [ { "value": "container", "label": "Container" }, { "value": "container-fluid", "label": "Fluid" } ] },
    { "type": "text", "id": "title_top", "label": "Nadnaslov", "default": "Galerija" },
    { "type": "text", "id": "title", "label": "Naslov", "default": "Iz našega čebelnjaka" },
    { "type": "textarea", "id": "des", "label": "Uvod" },
    { "type": "range", "id": "row_height", "label": "Višina vrstice na računalniku", "min": 160, "max": 360, "step": 10, "unit": "px", "default": 250 },
    { "type": "text", "id": "button", "label": "Gumb pod galerijo" },
    { "type": "url", "id": "link", "label": "Povezava gumba" },
    { "type": "select", "id": "style_btn", "label": "Slog gumba", "default": "btn-underline", "options": [ { "value": "btn-theme", "label": "Poln" }, { "value": "btn-outline", "label": "Obroba" }, { "value": "btn-underline", "label": "Podčrtan" } ] },
    { "type": "header", "content": "Odmiki" },
    { "type": "range", "id": "padding_top", "label": "Odmik zgoraj", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Odmik spodaj", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Fotografija",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotografija" },
        { "type": "select", "id": "size", "label": "Velikost", "default": "normal", "options": [ { "value": "normal", "label": "Navadna (1 × 1)" }, { "value": "wide", "label": "Široka (2 × 1)" }, { "value": "tall", "label": "Visoka (1 × 2)" }, { "value": "big", "label": "Velika (2 × 2)" } ] },
        { "type": "select", "id": "position", "label": "Izrez", "default": "center center", "options": [ { "value": "center top", "label": "Zgoraj" }, { "value": "center center", "label": "Sredina" }, { "value": "center bottom", "label": "Spodaj" } ] },
        { "type": "text", "id": "title", "label": "Oznaka (neobvezno)" },
        { "type": "text", "id": "caption", "label": "Napis (neobvezno)" }
      ]
    }
  ],
  "presets": [ { "name": "Galerija (Šemen)", "blocks": [ { "type": "photo", "settings": { "size": "big" } }, { "type": "photo" }, { "type": "photo" }, { "type": "photo", "settings": { "size": "wide" } } ] }
  ]
}
{% endschema %}
