<!-- featured-articles.liquid -->
<style>
  .blog-section{{ section.id }}{
    position: relative;
    z-index: {{ section.settings.zindex }};
  }
  .article__photo-wrapper.portrait{
    padding-top: 120% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.square{
    padding-top: 100% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.landscape{
    padding-top: 75% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.wide{
    padding-top: 56% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.portrait img,.article__photo-wrapper.square img, .article__photo-wrapper.landscape img,.article__photo-wrapper.wide img{
    height: 100%;
    object-fit: cover;
  }
  .bloglist-wrapper .blog__item{
    margin-bottom: 0 !important;
    padding-bottom: 0px !important;
  }
  /* fewer posts than columns: the cards share the full container width (no slider) */
  .blog-section{{ section.id }} .bloglist-static{
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
    gap: {{ section.settings.gutter_padding }}px;
    margin: 0;
    opacity: 1 !important;
  }
  .blog-section{{ section.id }} .bloglist-static > .bloglist-item{
    max-width: none;
    width: auto;
    padding: 0;
  }
  @media (max-width: 749px){
    .blog-section{{ section.id }} .bloglist-static{ grid-template-columns: minmax(0, 1fr); row-gap: 48px; }
  }
  @media(max-width:749px){
    .blog__item--3 .article__photo-wrapper{
      padding-top: 100% !important;
    }
  }
</style>
{%- liquid

  assign image_size = section.settings.image_size
  assign enable_btn_blog = section.settings.enable_btn_blog
  assign enable_btn_line = section.settings.enable_btn_line
  assign enable_date = section.settings.enable_date
  assign enable_tag = section.settings.enable_tag
  assign enable_comment = section.settings.enable_comment
  assign enable_short = section.settings.enable_short

  # Optional tag filter (Šemen): only posts carrying this tag, case-insensitive. The first matching post is the
  # big feature when feature_first is on; the slider skips it. With a filter and no matching posts the section
  # renders nothing for visitors (a short hint in the theme editor).
  assign feature_blog = blogs[section.settings.blog]
  assign filter_tag = section.settings.filter_tag | strip | downcase
  assign match_count = 0
  assign feature_handle = ''
  if feature_blog != blank
    for a in feature_blog.articles
      if filter_tag != blank
        assign a_tags = a.tags | join: '|' | downcase | split: '|'
        unless a_tags contains filter_tag
          continue
        endunless
      endif
      assign match_count = match_count | plus: 1
      if feature_handle == ''
        assign feature_handle = a.handle
        assign feature_article = a
      endif
    endfor
  endif
  unless section.settings.feature_first
    assign feature_handle = ''
  endunless
  assign hide_section = false
  if filter_tag != blank and match_count == 0
    assign hide_section = true
  endif
  # Fewer posts than columns (e.g. 2 tagged posts, 3 columns): a plain grid that fills the full container width
  # instead of the slider, 1 column on phones.
  assign grid_count = match_count
  if feature_handle != ''
    assign grid_count = grid_count | minus: 1
  endif
  assign grid_count = grid_count | at_most: section.settings.limit
  assign static_grid = false
  if grid_count > 0 and grid_count < section.settings.show
    assign static_grid = true
  endif
-%}
{%- if hide_section -%}
  {%- if request.design_mode -%}
    <div class="container" style="padding: 32px 0; text-align: center; opacity: .7;">Ni objav z oznako »{{ section.settings.filter_tag | strip | escape }}«. Sekcija je obiskovalcem skrita.</div>
  {%- endif -%}
{%- else -%}
<div class="customstyle{{ section.id }} blog-section{{section.id}}" data-aos="{{ section.settings.animation }}">
  {%- render 'style-section' -%}
<div class="{{ section.settings.setwidth }}">
  <div class="section-block">
    {%- render 'section-heading' -%}
    {%- if feature_handle != '' -%}
      {%- render 'semen-article-feature', article: feature_article -%}
    {%- endif -%}
    <div class="bloglist-wrapper dots-negative " data-aos="{{ section.settings.animation }}">
      {%- if static_grid -%}
      <div class="bloglist-static" id="Bloglist-{{ section.id }}" style="--cols: {{ grid_count }};">
      {%- else -%}
      <div class="bloglist-slider row" id="Bloglist-{{ section.id }}"
           data-rows="{{ section.settings.rows }}"
           data-slidesToShow="{{ section.settings.show }}"
           data-arrows="{{ section.settings.arrows }}"
           data-dots="{{ section.settings.dots }}" 
           data-draggable="{{ section.settings.draggable }}" 
           data-infinite="{{ section.settings.infinite }}" 
           data-section-id="{{ section.id }}" 
           data-section-type="slickCarousels">
      {%- endif -%}
        {%- assign blog = blogs[section.settings.blog] -%}
        {%- assign limit = section.settings.limit -%}
        {%- if blog != blank -%}
        {%- assign shown = 0 -%}
        {%- for article in blog.articles -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- if article.handle == feature_handle -%}{%- continue -%}{%- endif -%}
        {%- if filter_tag != blank -%}
          {%- assign a_tags = article.tags | join: '|' | downcase | split: '|' -%}
          {%- unless a_tags contains filter_tag -%}{%- continue -%}{%- endunless -%}
        {%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <div class="bloglist-item col">
          <div data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ shown | times: 100 }}">
            {%- liquid
              case section.settings.item_style
              when 'blog-1'
                render 'blog-grid-1', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              when 'blog-3'
                render 'blog-grid-3', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              when 'blog-5'
                render 'blog-grid-5', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              when 'blog-6'
                render 'blog-grid-6', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              when 'blog-7'
                render 'blog-grid-7', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              else
                render 'blog-grid-blank'
              endcase
            -%}
          </div>
        </div>
        {%- endfor -%}
        {%- else -%}
        {%- for i in (1..limit) -%}
        <div class="bloglist-item col">
          <div data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}">
          {%- render 'blog-grid-blank' -%}
        </div>
        </div>
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
</div>
{%- endif -%}

