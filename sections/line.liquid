        },
        {
          "value": "fade-up-right",
          "label": "Pojav navzgor desno"
        },
        {
          "value": "fade-up-left",
          "label": "Pojav navzgor levo"
        },
        {
          "value": "fade-down-right",
          "label": "Pojav navzdol desno"
        },
        {
          "value": "fade-down-left",
          "label": "Pojav navzdol levo"
        },
        {
          "value": "flip-up",
          "label": "Obrat navzgor"
        },
        {
          "value": "flip-down",
          "label": "Obrat navzdol"
        },
        {
          "value": "flip-left",
          "label": "Obrat v levo"
        },
        {
          "value": "flip-right",
          "label": "Obrat v desno"
        },
        {
          "value": "slide-up",
          "label": "Zdrs navzgor"
        },
        {
          "value": "slide-down",
          "label": "Zdrs navzdol"
        },
        {
          "value": "slide-left",
          "label": "Zdrs v levo"
        },
        {
          "value": "slide-right",
          "label": "Zdrs v desno"
        },
        {
          "value": "zoom-in",
          "label": "Povečava"
        },
        {
          "value": "zoom-in-up",
          "label": "Povečava navzgor"
