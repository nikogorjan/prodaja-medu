          "label": "Pomanjšava navzdol"
        },
        {
          "value": "zoom-out-left",
          "label": "Pomanjšava v levo"
        },
        {
          "value": "zoom-out-right",
          "label": "Pomanjšava v desno"
        }
      ],
      "label": "Animacija ob prikazu"
    },
    {
      "type": "text",
      "id": "paddingsection",
      "label": "Notranji odmik sekcije",
      "default": "0px 0px 0px 0px",
      "info": "Notranji odmik: zgoraj desno spodaj levo"
    },
    {
      "type": "text",
      "id": "marginsection",
      "label": "Zunanji odmik sekcije",
      "default": "0px 0px 0px 0px",
