    },
    {
      "type": "color",
      "id": "bgsection",
      "label": "Ozadje sekcije",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "setwidth",
      "label": "Čez celo širino",
      "default": "container",
