<!-- featured-products.liquid -->
<div class="customstyle{{ section.id }} " >
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
      {%- liquid
        render 'section-heading' 
        assign collection = collections[section.settings.collection] 
        assign rows = section.settings.rows 
      -%}
      {%- if collection != blank -%}
      {%- assign product_limit = rows -%}
      <div class="row {% if section.settings.enable_creative %} psection-creative {% endif %} {% unless section.settings.padding %} m-0 {% endunless %}" data-aos="{{ section.settings.animation }}">
        {%- liquid
          # Šemen: "Razvrsti po številu nagrad" - izdelki z več nagradami (metapolje custom.nagrade) so prvi,
          # pri enakem številu ostane vrstni red zbirke. Zanka gre po ravneh od največ nagrad do 0.
          assign top_awards = 0
          if section.settings.sort_awards
            for p in collection.products
              assign n = p.metafields.custom.nagrade.value.size | default: 0
              if n > top_awards
                assign top_awards = n
              endif
            endfor
          endif
          assign shown = 0
        -%}
        {%- for level in (0..top_awards) reversed -%}
        {%- for product in collection.products -%}
        {%- liquid
          if shown >= product_limit
            break
          endif
          if section.settings.sort_awards
            assign n = product.metafields.custom.nagrade.value.size | default: 0
            if n != level
              continue
            endif
          endif
          assign shown = shown | plus: 1
        -%}
        <div class="{{ section.settings.colgrid }} col-md-6 col-sm-6 col-xs-6 col-6 {% unless section.settings.padding %} p-0 {% endunless %} col-item "
          data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ shown | times: 50 }}" >
          {%- render 'product-card', product: product, collection: collection -%}
        </div>
        {%- endfor -%}
        {%- endfor -%}
        {% if section.settings.txtbutton != blank %}
        <div class="text-center col-12">
          <a class="btn {{ section.settings.style_btn }}" href="{{ section.settings.urlbtn }}">{{ section.settings.txtbutton }}</a>
        </div>
        {% endif %}
      </div>
      {%- else -%}
      <div class="row {% if section.settings.enable_creative %} psection-creative {% endif %} ">
        {%- assign product_limit = rows -%}
        {%- for i in (1..product_limit) -%}
        <div class="{{ section.settings.colgrid }} col-sm-6 col-xs-6 col-item"  data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 50 }}">
          {%- render 'product-grid-blank' -%}
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</div>
